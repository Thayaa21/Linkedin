# Copy this to .env and fill in your values

# ── Google ──────────────────────────────────────────────────────────────────
SHEET_ID=your_google_sheet_id_here
SHEET_TAB=Applications
SENT_TAB=Sent Messages
GOOGLE_CREDS_FILE=google_creds.json
DRIVE_FOLDER_ID=your_drive_folder_id_here

# ── LinkedIn ─────────────────────────────────────────────────────────────────
COOKIES_FILE=linkedin_cookies.json
CONNECTIONS_SNAPSHOT=connections_snapshot.json

# ── Scheduler ────────────────────────────────────────────────────────────────
POLL_INTERVAL_HOURS=6
SEND_HOUR=9

# How many days after the Tracker "Applied Date" we still send referral DMs.
MESSAGE_APPLY_WITHIN_DAYS=12

# Poll only the most-recently-added connections (already-snapshotted ones skipped).
MAX_POLL_CONNECTIONS=100

# ── OpenAI (company extraction from headline; optional) ──────────────────────
# If omitted, a regex fallback is used instead.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Message (optional — default template used if omitted) ───────────────────
# MESSAGE_TEMPLATE=Hi {first_name}, ...
